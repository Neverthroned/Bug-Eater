  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 161263380}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fed4711e9b2c0be41b2067aea22339ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SnailChoiceController
  introDialogue:
    characterName: 
    sentences:
    - So, you made it...
    - I think you already know by now what must be done.
    - 'It''s sad, really. But this is a great opportunity! '
    - 'We helped give you life. We were there when you needed us.  '
    - Now, you are part of us. Together, we will unify the whole world.
    - What do you say? Will you eat me, and bring the whole world  to a new level
      of peace?
  yesDialogue:
    characterName: 
    sentences:
    - Excellent choice...
    - Let's unify your race, and show the world our collective mind.
  noDialogue:
    characterName: 
    sentences:
    - 'Fine. '
    - 'But you will change your mind. '
    - But if you think you're so bold...
    - Why don't you go into those lights?
    - See what happens...
  choicePanel: {fileID: 398299768}
